# DevOS project .gitignore

# ----- Python -----
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
/.venv/

# Local env files
.env
devos-backend/.env

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# ----- Node -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- CMake / Build -----
# build directories
build/
DevOS/build/
cmake-build-*/

# CMake files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# object files, libraries, executables
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.dll
*.exe
*.so
*.dylib
*.pdb
*.ilk

# ----- Qt / autogenerated files -----
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
*.pro.user*
*.qmake.stash

# ----- IDE / Editor -----
.vscode/
.idea/
*.suo
*.user
*.user.*
*.sln
*.vcxproj*
*.xcodeproj
*.xcworkspace
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs and local data -----
logs/
*.log

# ----- Workspace / generated projects -----
# Don't commit generated workspaces or created project trees
workspace/
devos-backend/workspace/
*/workspace/

# ----- Frontend / bundlers -----
dist/
public/build/
frontend/build/

# Ignore deployment helpers from Qt
*.manifest

# Keep other local machine files out
*.swp
*.swo
